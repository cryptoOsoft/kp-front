{
  "name": "kp-front-web",
  "description": "KP Front — Einsatzführungs-app for frontline fire-service command: situation map, plan whiteboard, live documentation, offline-capable.",
  "private": true,
  "version": "0.12.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "node scripts/lint-ratchet.mjs",
    "lint:update": "node scripts/lint-ratchet.mjs --update",
    "knip": "node scripts/knip-ratchet.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:smoke": "node scripts/mutation-smoke.mjs",
    "coverage:raise": "node scripts/coverage-raise.mjs",
    "test:e2e": "playwright test",
    "bench": "vitest bench --run",
    "openapi:types": "openapi-typescript docs/openapi.json --default-non-nullable false -o src/lib/api/schema.d.ts",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "jspdf": "^4.2.1",
    "maplibre-gl": "^6.11.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "~30.0.1",
    "knip": "^6.44.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  }
}
